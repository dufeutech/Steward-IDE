{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "steward-ide",
  "version": "0.1.0",
  "identifier": "com.steward.ide",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "steward-ide",
        "width": 800,
        "height": 600,
        "url": "pack://localhost"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["config/", "shell/", "schemas/", "packs-baseline/", "tuf/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
